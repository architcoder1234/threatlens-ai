PORT=5000
NODE_ENV=development

# Optional LLM API Key (OpenAI / Gemini / Anthropic compatible or fallback mock AI mode)
# If not provided, ThreatLens AI operates in advanced deterministic + local NLP mode without breaking!
GEMINI_API_KEY=
OPENAI_API_KEY=

# External Threat Intelligence APIs (Optional - graceful fallbacks included)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=

# MongoDB URI (Optional - in-memory/file storage abstraction is active by default)
MONGODB_URI=
